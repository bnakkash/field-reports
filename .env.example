# Copy to .env for local development.
# In CI this comes from a GitHub Actions *variable* of the same name —
# it is a public URL, not a secret, and the build needs to read it.

VITE_STRUCTURE_ENDPOINT=https://itxcaamyiilvotfzctit.supabase.co/functions/v1/structure-report

# Only if you set FR_SHARED_SECRET on the Edge Function.
# Note: anything with VITE_ prefix ends up in the public bundle. This value
# is a speed bump against casual abuse, not a secret.
# VITE_FR_KEY=
