# Copy to .env for local development.
# In CI this comes from a GitHub Actions *variable* of the same name —
# it is a public URL, not a secret, and the build needs to read it.

VITE_STRUCTURE_ENDPOINT=https://itxcaamyiilvotfzctit.supabase.co/functions/v1/structure-report

# There is deliberately no key here.
#
# The proxy's shared secret (FR_SHARED_SECRET) is never built into the bundle —
# a VITE_ variable ends up in the public JavaScript, which makes it readable by
# anyone and therefore not a secret. The app asks for the passphrase once per
# device when the proxy answers 401, and keeps it in that device's own storage.
